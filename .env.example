# DevSecOps Pipeline Guardian - Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/devsecops_guardian
REDIS_URL=redis://localhost:6379/0

# SonarQube Configuration
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=your_sonarqube_token_here

# Snyk Configuration
SNYK_TOKEN=your_snyk_token_here

# NIST NVD API Configuration
NVD_API_KEY=your_nvd_api_key_here

# OWASP ZAP Configuration
ZAP_API_KEY=your_zap_api_key_here
ZAP_HOST=http://localhost:8090

# OPA Configuration
OPA_URL=http://localhost:8181
OPA_POLICY_PACKAGE=devsecops.security

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_random_secret_key

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard Configuration
DASHBOARD_URL=http://localhost:3000

# Metrics & Monitoring
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001

# Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
NOTIFICATION_EMAIL=security-team@example.com

# Slack Notifications (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# GitHub Integration (Optional)
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO_OWNER=your_org
GITHUB_REPO_NAME=your_repo

# Docker Configuration
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your_docker_username
DOCKER_PASSWORD=your_docker_password
